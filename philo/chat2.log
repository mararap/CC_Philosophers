## Makefile
```makefile
NAME    = philo

CC      = cc
CFLAGS  = -Wall -Wextra -Werror
LDFLAGS = -lpthread

SRCS    = main.c init.c utils.c actions.c threads.c monitor.c cleanup.c
OBJS    = $(SRCS:.c=.o)

all: $(NAME)

$(NAME): $(OBJS) philo.h
	$(CC) $(CFLAGS) -o $(NAME) $(OBJS) $(LDFLAGS)

%.o: %.c philo.h
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
```

