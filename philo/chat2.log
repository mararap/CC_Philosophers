### actions.c — the key file
```c
#include "philo.h"

/*
** Smart & Polite fork acquisition (Hinnant 2014).
**
** Iteration 1: block on 'a', try 'b'.  If try fails → release 'a', yield.
** Iteration 2: block on 'b', try 'a'.  If try fails → release 'b', yield.
** Repeat.  Deadlock-free because you never block while already holding a lock.
** Livelock-free because yield() hands CPU time to competing threads and the
** alternating acquisition order breaks symmetry.
*/
static void	lock_two_forks(t_fork *a, t_fork *b)
{
	while (1)
	{
		pthread_mutex_lock(a);
		if (pthread_mutex_trylock(b) == 0)
			return ;
		pthread_mutex_unlock(a);
		usleep(1);
		pthread_mutex_lock(b);
		if (pthread_mutex_trylock(a) == 0)
			return ;
		pthread_mutex_unlock(b);
		usleep(1);
	}
}

void	ph_take_forks(t_philo *p)
{
	if (p->dinner->philo_count == 1)
	{
		pthread_mutex_lock(p->left);
		ph_print(p, "has taken a fork");
		return ;
	}
	lock_two_forks(p->left, p->right);
	pthread_mutex_lock(&p->dinner->meal_lock);
	p->last_meal = ph_get_time_us();
	pthread_mutex_unlock(&p->dinner->meal_lock);
	ph_print(p, "has taken a fork");
	ph_print(p, "has taken a fork");
}

void	ph_eat(t_philo *p)
{
	long long	end;

	if (p->dinner->philo_count == 1)
	{
		while (!ph_is_done(p->dinner))
			usleep(500);
		return ;
	}
	ph_print(p, "is eating");
	end = p->last_meal + p->dinner->time_to_eat;
	while (ph_get_time_us() < end && !ph_is_done(p->dinner))
		usleep(100);
	pthread_mutex_lock(&p->dinner->meal_lock);
	p->meal_count++;
	pthread_mutex_unlock(&p->dinner->meal_lock);
}

void	ph_drop_forks(t_philo *p)
{
	pthread_mutex_unlock(p->left);
	if (p->dinner->philo_count > 1)
		pthread_mutex_unlock(p->right);
}

void	ph_sleep(t_philo *p)
{
	long long	end;

	ph_print(p, "is sleeping");
	end = ph_get_time_us() + p->dinner->time_to_sleep;
	while (ph_get_time_us() < end && !ph_is_done(p->dinner))
		usleep(100);
}

/*
** With smart & polite, think is a natural pause: the philosopher immediately
** tries to grab forks; lock_two_forks()'s yield loop acts as the thinking
** delay under contention.  No artificial sleep is needed here.
*/
void	ph_think(t_philo *p)
{
	ph_print(p, "is thinking");
}
```

---

### threads.c
```c
#include "philo.h"

int	ph_is_done(t_dinner *d)
{
	int	result;

	pthread_mutex_lock(&d->done_lock);
	result = d->is_done;
	pthread_mutex_unlock(&d->done_lock);
	return (result);
}

static void	*ph_routine(void *arg)
{
	t_philo	*p;

	p = (t_philo *)arg;
	pthread_mutex_lock(&p->dinner->meal_lock);
	p->last_meal = p->dinner->start_time;
	pthread_mutex_unlock(&p->dinner->meal_lock);
	while (!ph_is_done(p->dinner))
	{
		ph_take_forks(p);
		ph_eat(p);
		ph_drop_forks(p);
		ph_sleep(p);
		ph_think(p);
	}
	return (NULL);
}

int	ph_start_threads(t_dinner *d)
{
	int	i;

	i = 0;
	while (i < d->philo_count)
	{
		if (pthread_create(&d->philos[i].tid, NULL, ph_routine,
				&d->philos[i]) != 0)
		{
			pthread_mutex_lock(&d->done_lock);
			d->is_done = 1;
			pthread_mutex_unlock(&d->done_lock);
			while (--i >= 0)
				pthread_join(d->philos[i].tid, NULL);
			return (1);
		}
		i++;
	}
	i = 0;
	while (i < d->philo_count)
		pthread_join(d->philos[i++].tid, NULL);
	return (0);
}
```

