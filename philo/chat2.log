### cleanup.c
```c
#include "philo.h"

/*
** stage: how many of the three shared mutexes were initialized
**   1 → print_lock only
**   2 → print_lock + done_lock
**   3 → print_lock + done_lock + meal_lock
*/
void	ph_cleanup(t_dinner *d, int stage)
{
	int	i;

	if (stage >= 3)
		pthread_mutex_destroy(&d->meal_lock);
	if (stage >= 2)
		pthread_mutex_destroy(&d->done_lock);
	if (stage >= 1)
		pthread_mutex_destroy(&d->print_lock);
	i = 0;
	while (i < d->forks_init)
		pthread_mutex_destroy(&d->forks[i++]);
	if (d->forks)
		free(d->forks);
	if (d->philos)
		free(d->philos);
	d->forks = NULL;
	d->philos = NULL;
}
```

