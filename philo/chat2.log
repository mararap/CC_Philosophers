### main.c
```c
#include "philo.h"

static int	ph_parse_args(int ac, char **av, t_dinner *d)
{
	int	i;

	if (ac < 5 || ac > 6)
		return (write(2, "usage: philo N ttd tte tts [meals]\n", 35), 1);
	i = 1;
	while (i < ac)
	{
		if (ph_atoull(av[i]) == -1)
			return (write(2, "invalid argument\n", 17), 1);
		i++;
	}
	d->philo_count = (int)ph_atoull(av[1]);
	if (d->philo_count <= 0)
		return (write(2, "invalid argument\n", 17), 1);
	d->time_to_die   = ph_atoull(av[2]) * 1000;
	d->time_to_eat   = ph_atoull(av[3]) * 1000;
	d->time_to_sleep = ph_atoull(av[4]) * 1000;
	d->meals_required = (ac == 6) ? (int)ph_atoull(av[5]) : -1;
	return (0);
}

int	main(int ac, char **av)
{
	t_dinner	dinner;
	pthread_t	monitor_tid;

	if (ph_parse_args(ac, av, &dinner) != 0)
		return (1);
	if (ph_init_dinner(&dinner) != 0)
		return (1);
	if (ph_init_forks(&dinner) != 0)
		return (ph_cleanup(&dinner, 3), 1);
	dinner.start_time = ph_get_time_us();
	ph_init_philos(&dinner);
	if (pthread_create(&monitor_tid, NULL, ph_monitor, &dinner) != 0)
		return (ph_cleanup(&dinner, 3), 1);
	ph_start_threads(&dinner);
	pthread_join(monitor_tid, NULL);
	ph_cleanup(&dinner, 3);
	return (0);
}
```

